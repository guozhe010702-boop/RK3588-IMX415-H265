# Board-only configuration. No credentials.
DEVICE=/dev/video44
WIDTH=2560
HEIGHT=1440
FPS=60
BUFFERS=3
SKIP=5
# Only this application's capture thread; never changes AIQ/IRQ/other services.
# 0 = normal scheduling. Nonzero requires root/CAP_SYS_NICE.
CAPTURE_PRIORITY=0
BITRATE=40000000
GOP=10
DESTINATION='udp://192.168.2.165:1235?pkt_size=1316'
FFMPEG=/userdata/av_dev/ffmpeg_pipeline/runtime/bin/ffmpeg
FFMPEG_LIB=/userdata/av_dev/ffmpeg_pipeline/runtime/lib:/userdata/av_dev/ffmpeg_pipeline/runtime/lib64
